<section class="ftags-spotlight__results">
  {{#if hasResults}}
    <div class="ftags-spotlight__list" role="listbox" aria-label="{{localize 'FTAGS.Spotlight.ResultsLabel'}}">
      {{#each results}}
        <button
          type="button"
          class="ftags-spotlight__result{{#if selected}} is-selected{{/if}}"
          role="option"
          aria-selected="{{selected}}"
          aria-label="{{openLabel}}"
          id="{{resultId}}"
          data-action="openResult"
          data-uuid="{{uuid}}"
          data-ftags-result
        >
          <i class="{{icon}} ftags-spotlight__result-icon" aria-hidden="true"></i>
          <span class="ftags-spotlight__result-copy">
            <strong>{{name}}</strong>
            <small>{{metadata}}</small>
          </span>
          <span class="ftags-spotlight__result-tags" aria-hidden="true">
            {{#each tags}}
              <span class="ftags-chip" style="--ftags-tag-color: {{color}};" title="{{name}}">{{name}}</span>
            {{/each}}
          </span>
        </button>
      {{/each}}
    </div>
    <footer class="ftags-spotlight__footer" aria-live="polite">
      <span>{{resultCountLabel}}</span>
      <span>{{localize "FTAGS.Spotlight.Help"}}</span>
    </footer>
  {{else}}
    <p class="ftags-empty" aria-live="polite">
      {{#if hasIndex}}{{localize "FTAGS.Spotlight.NoResults"}}{{else}}{{localize "FTAGS.Spotlight.Empty"}}{{/if}}
    </p>
  {{/if}}
</section>
